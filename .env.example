# Optional for production-quality POI search.
# Create a Web Service key in the AMap console and restrict it to your app/back-end.
EXPO_PUBLIC_AMAP_WEB_SERVICE_KEY=

# Optional API integration. Leave empty to keep the current local-only demo.
EXPO_PUBLIC_API_URL=

# Server-only settings. Do not expose AUTH_SECRET in EXPO_PUBLIC_* variables.
AUTH_SECRET=
DATABASE_PATH=server/data/xueyue.sqlite
SMS_PROVIDER=development
DEV_AUTH_CODE=246810
PORT=3100
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:8081,http://localhost:8083
