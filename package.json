{
  "name": "xueyue",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "description": "雪约：滑雪人群的顺路拼车与同行协调工具。",
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-haptics": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "server": "node --experimental-sqlite server/index.mjs",
    "server:test": "node --experimental-sqlite --test server/app.test.mjs",
    "release:audit": "node scripts/release-audit.mjs --audit",
    "release:check": "node scripts/release-audit.mjs",
    "site": "python3 -m http.server 4173 --directory store-site",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "assets": "node scripts/generate-assets.mjs",
    "build:preview": "npx eas-cli@latest build --platform android --profile preview",
    "build:release": "npx eas-cli@latest build --platform android --profile production",
    "submit:android": "npx eas-cli@latest submit --platform android --profile production"
  },
  "private": true
}
